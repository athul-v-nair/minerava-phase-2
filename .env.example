# Minerva — env template (copy to .env)
# Required for PAT encryption (Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MINERVA_ENCRYPTION_KEY=change-me-32-byte-base64-fernet-key
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
GITLAB_WEBHOOK_TOKEN=change-me-gitlab-webhook-secret
BOT_USERNAME=minerva-bot

# DB
DATABASE_URL=sqlite:///./data/minerva.db

# LLM (Phase-1 local opencode)
LLM_BASE_URL=http://opencode:4000/v1
LLM_MODEL=opencode-default
LLM_TIMEOUT=30

# API
API_PORT=8000
WEB_PORT=5173
GITLAB_PORT=8929
